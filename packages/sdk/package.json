{
  "name": "@folio/engine",
  "version": "0.1.0",
  "description": "Framework-agnostic PDF engine (rendering, editing, conversion, OCR, signing, search) extracted from Folio.",
  "license": "Apache-2.0",
  "author": "Naledi Sandamela",
  "homepage": "https://github.com/naledisandamela/folio/tree/main/packages/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naledisandamela/folio.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/naledisandamela/folio/issues"
  },
  "keywords": ["pdf", "pdf-editor", "ocr", "pdf-signing", "acroform", "pdf-encryption"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ocr": {
      "types": "./dist/ocr.d.ts",
      "import": "./dist/ocr.js",
      "require": "./dist/ocr.cjs"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "import": "./dist/signing.js",
      "require": "./dist/signing.cjs"
    },
    "./convert": {
      "types": "./dist/convert.d.ts",
      "import": "./dist/convert.js",
      "require": "./dist/convert.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node smoke/node-smoke.mjs && node smoke/browser-smoke.mjs",
    "test": "npm run typecheck && npm run build && npm run smoke"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "tesseract.js": "^7.0.0",
    "node-forge": "^1.4.0",
    "crypto-js": "^4.2.0",
    "docx": "^9.7.1",
    "pptxgenjs": "^4.0.1",
    "jszip": "^3.10.1",
    "pako": "^3.0.1"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "@types/pako": "^2.0.4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "esbuild": "^0.27.7",
    "tsup": "^8.3.0",
    "typescript": "^5",
    "playwright": "^1.62.1"
  }
}
