{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "description": "A modern document workspace — read, edit, annotate, organize and sign PDFs.",
  "license": "GPL-3.0-or-later",
  "author": "Naledi Sandamela",
  "homepage": "https://github.com/naledisandamela/folio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naledisandamela/folio.git"
  },
  "bugs": {
    "url": "https://github.com/naledisandamela/folio/issues"
  },
  "workspaces": ["packages/*"],
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "electron:dev": "concurrently -k -s first \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "cross-env ELECTRON_BUILD=true next build && electron-builder",
    "electron:dist:win": "cross-env ELECTRON_BUILD=true next build && electron-builder --win --dir",
    "electron:installer:win": "cross-env ELECTRON_BUILD=true next build && electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@folio/engine": "^0.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node-forge": "^1.3.14",
    "@types/pako": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "node-forge": "^1.4.0",
    "pako": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.folio.app",
    "productName": "Folio",
    "copyright": "Copyright © 2026 Naledi Sandamela",
    "icon": "build/icon.ico",
    "directories": {
      "output": "../PDF-electron-dist"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "app-out"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Folio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio",
      "license": "LICENSE"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
